{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SMO BBA SHOP",
  "version": "2.3.15",
  "identifier": "org.smobba.store",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SMO BBA SHOP",
        "width": 1100,
        "height": 780,
        "minWidth": 375,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QkRENDAxQjExMzhCMjkKUldRcGl4T3hBZFM5U04xRWMyOEt3MTNVR0JYeTlpaUh2YjFZSHY4ci9hV04zamFUbThkb3hmc2QK",
      "endpoints": [
        "https://github.com/remitz98/SMOBBASHOP/releases/latest/download/latest.json"
      ]
    }
  }
}
