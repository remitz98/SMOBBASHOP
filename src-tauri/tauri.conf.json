{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BBA Store",
  "version": "1.0.4",
  "identifier": "org.smobba.store",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "SMO BBA SHOP",
        "width": 1100,
        "height": 780,
        "minWidth": 375,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
